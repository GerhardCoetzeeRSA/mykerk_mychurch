rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Gemeentes — each congregation's own admin has full access to their
    // own document. The super admin (you) can read every congregation,
    // but ONLY your specific account — not "anyone who is logged in."
    match /gemeentes/{gemeenteId} {
      allow read, write: if request.auth != null
        && request.auth.uid == gemeenteId;

      allow read: if request.auth != null
        && request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE';

      // Subcollections (lede, gebeure, gebede, etc.)
      match /{collection}/{docId} {
        allow read: if request.auth != null
          && (request.auth.uid == gemeenteId
            || get(/databases/$(database)/documents/gebruikers/$(request.auth.uid)).data.gemeenteId == gemeenteId
            || request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE');
        allow write: if request.auth != null
          && request.auth.uid == gemeenteId;
      }
    }

    // Gebruikers — each user can read/write their own profile only.
    // Super admin can read all user profiles (support lookups etc).
    match /gebruikers/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
      allow read: if request.auth != null
        && request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE';
    }
  }
}
