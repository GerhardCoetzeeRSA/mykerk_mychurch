rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin(gemeenteId) {
      return request.auth != null && request.auth.uid == gemeenteId;
    }

    function isMember(gemeenteId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/gebruikers/$(request.auth.uid))
        && get(/databases/$(database)/documents/gebruikers/$(request.auth.uid)).data.gemeenteId == gemeenteId;
    }

    function isSuperAdmin() {
      return request.auth != null && request.auth.uid == 'rinnYZ2e7GSmzaEcbJ4RGBfzK592';
    }

    match /gemeentes/{gemeenteId} {
      // Only the congregation's own admin, its members, or you can read it —
      // NOT "any signed-in user".
      allow read: if isAdmin(gemeenteId) || isMember(gemeenteId) || isSuperAdmin();
      allow write: if isAdmin(gemeenteId) || isSuperAdmin();

      // Members (lede) — admin manages the list; a new member may create
      // ONLY their own doc (docId must equal their own uid) — this is what
      // self-registration via a congregation code does.
      match /lede/{docId} {
        allow read: if isAdmin(gemeenteId) || isMember(gemeenteId);
        allow create: if isAdmin(gemeenteId) || (request.auth != null && request.auth.uid == docId);
        allow update, delete: if isAdmin(gemeenteId);
      }

      // Prayers (gebede) — any admin or member can post a prayer or tap
      // "pray along" (increments prayerCount). Only admin deletes.
      match /gebede/{docId} {
        allow read: if isAdmin(gemeenteId) || isMember(gemeenteId);
        allow create: if isAdmin(gemeenteId) || isMember(gemeenteId);
        allow update: if isAdmin(gemeenteId) || isMember(gemeenteId);
        allow delete: if isAdmin(gemeenteId);
      }

      // Events — real collection name is "gebeure". Members read, admin writes.
      match /gebeure/{docId} {
        allow read: if isAdmin(gemeenteId) || isMember(gemeenteId);
        allow write: if isAdmin(gemeenteId);
      }

      // Sermons — congregation-wide library. Members read, admin writes.
      match /preke/{docId} {
        allow read: if isAdmin(gemeenteId) || isMember(gemeenteId);
        allow write: if isAdmin(gemeenteId);
      }

      // Volunteers — members can see who's serving, admin manages the list.
      match /vrywilligers/{docId} {
        allow read: if isAdmin(gemeenteId) || isMember(gemeenteId);
        allow write: if isAdmin(gemeenteId);
      }

      // Membership applications — not yet used by the app, kept ready:
      // anyone signed in can submit, only admin can read/manage.
      match /aansoeke/{docId} {
        allow create: if request.auth != null;
        allow read, update, delete: if isAdmin(gemeenteId);
      }

      // Custom role definitions — members need to read this so their own
      // badge labels/colors render correctly, but only admin can edit it.
      // This is a narrower exception carved out of the admin-only
      // instellings catch-all below.
      match /instellings/rolle {
        allow read: if isAdmin(gemeenteId) || isMember(gemeenteId);
        allow write: if isAdmin(gemeenteId);
      }

      // Everything else — bywoning (attendance), instellings (incl. banking
      // details), checkin (children) — admin ONLY, both read and write.
      // These are management/financial/child-safety data, not
      // member-visible by design.
      match /{collection}/{docId} {
        allow read, write: if isAdmin(gemeenteId);
      }
    }

    // Gebruikers — each user reads/writes only their own profile.
    // Super admin can read all profiles (support lookups).
    match /gebruikers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isSuperAdmin();
    }
  }
}
